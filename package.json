{
  "name": "agentdyno",
  "version": "0.4.0",
  "description": "The dyno bench for local coding agents: scan your machine, fit the right open model, and PROVE it can drive tools before you wire up Claude Code, OpenCode, or Aider. Includes a guided setup wizard (CLI or browser UI), model switcher, local dashboard/API, VS Code extension, and an Ollama backend.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dyno": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "src/catalog.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test 'test/*.test.js'",
    "catalog": "npm run build && node dist/tools/build-catalog.js"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sauravGit/agentdyno"
  },
  "keywords": [
    "llm",
    "local",
    "agent",
    "claude-code",
    "llama.cpp",
    "benchmark",
    "tool-calling"
  ],
  "dependencies": {
    "js-yaml": "^5.2.2"
  }
}